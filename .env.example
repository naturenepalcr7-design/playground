# ============================================================================
# KMC-GIS-SERVER Environment Configuration Example
# Copy this to .env and modify values for your environment
# NOTE: Never commit .env to version control or expose it publicly.
# ============================================================================

# ---- Server Host Port ----
# The only port mapped to the host server.
# Avoids conflicting with 80, 443, 3000, 8000, 8080.
HOST_PORT=8090

# ---- Database (PostgreSQL / PostGIS) ----
POSTGRES_DB=kmc_gis
POSTGRES_USER=kmc_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis Cache & Task Locks ----
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ---- JWT / Authentication ----
SECRET_KEY=CHANGE_ME_MINIMUM_32_CHARACTERS_JWT_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Initial Administrator Account ----
ADMIN_USERNAME=KmcSuperUser2083
ADMIN_EMAIL=admin@kmc.gov.np
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_FULL_NAME=KMC GIS Administrator

# ---- TileServer-GL ----
TILESERVER_INTERNAL_URL=http://tileserver:8080
TILESERVER_DATA_DIR=/tileserver-data

# ---- Application Configuration ----
MAX_UPLOAD_SIZE_MB=8192
CORS_ORIGINS=http://localhost:8090,http://127.0.0.1:8090,http://localhost,http://localhost:80
APP_NAME=KMC-GIS-SERVER
APP_VERSION=1.0.0
DEBUG=false

# Optional: Public facing domain or URL if behind an upstream reverse proxy (e.g. https://gis.kmc.gov.np)
PUBLIC_SERVER_URL=
